<!DOCTYPE html>
<html lang="en">
  <%- include('./partials/head.ejs') %>

  <body>
    <main class="page-shell narrow-page">
      <%- include('./partials/nav.ejs') %>

      <section class="form-card">
        <h1>Create a New Course</h1>
        <p class="page-subtext">Add a course to the academy catalog.</p>

        <form action="/courseTeach" method="POST">
          <label for="name">Course Name</label>
          <input type="text" id="name" name="name" required />

          <label for="description">Course Description</label>
          <input type="text" id="description" name="description" required />

          <label for="subjectArea">Subject Area</label>
          <input type="text" id="subjectArea" name="subjectArea" required />

          <label for="credits">Credits</label>
          <input type="number" id="credits" name="credits" min="1" required />

          <div class="button-container">
            <button class="primary-btn" type="submit">Create Course</button>
          </div>
        </form>
      </section>

      <%- include('./partials/footer.ejs') %>
    </main>
  </body>
</html>